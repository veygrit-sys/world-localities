{
  "schema_version": 1,
  "package": "localities",
  "registries": [
    {
      "id": "official",
      "path": "registries/official",
      "role": "official_overlay",
      "scope": "country-specific official codes, names, and postal joins"
    },
    {
      "id": "africa",
      "path": "registries/africa",
      "role": "regional_registry",
      "scope": "Africa"
    },
    {
      "id": "asia",
      "path": "registries/asia",
      "role": "regional_registry",
      "scope": "Asia with documented Russia supplement"
    },
    {
      "id": "europe",
      "path": "registries/europe",
      "role": "regional_registry",
      "scope": "Europe"
    },
    {
      "id": "oceania",
      "path": "registries/oceania",
      "role": "regional_registry",
      "scope": "Oceania"
    },
    {
      "id": "americas",
      "path": "registries/americas",
      "role": "regional_coordinator",
      "scope": "Americas quality audit and release coordination"
    },
    {
      "id": "north-america",
      "path": "registries/north-america",
      "role": "regional_registry",
      "scope": "UN M49 Northern America"
    },
    {
      "id": "central-america",
      "path": "registries/central-america",
      "role": "regional_registry",
      "scope": "UN M49 Central America",
      "split_materialization": true
    },
    {
      "id": "caribbean",
      "path": "registries/caribbean",
      "role": "regional_registry",
      "scope": "UN M49 Caribbean",
      "split_materialization": true
    },
    {
      "id": "south-america",
      "path": "registries/south-america",
      "role": "regional_registry",
      "scope": "UN M49 South America",
      "split_materialization": true
    }
  ],
  "shared_components": [
    {
      "module": "localities.geonames",
      "consumers": [
        "registries/caribbean/build.py",
        "registries/central-america/build.py",
        "registries/south-america/build.py",
        "registries/south-america/publication.py",
        "registries/south-america/query.py"
      ]
    },
    {
      "module": "localities.materialize",
      "consumers": [
        "registries/central-america/build.py",
        "registries/central-america/build_names.py",
        "registries/central-america/quality.py",
        "registries/central-america/query.py",
        "registries/central-america/verify.py",
        "registries/south-america/build.py",
        "registries/south-america/publication.py",
        "registries/south-america/query.py"
      ]
    },
    {
      "module": "localities.query",
      "consumers": [
        "registries/africa/query.py",
        "registries/caribbean/query.py",
        "registries/central-america/query.py",
        "registries/south-america/query.py"
      ]
    }
  ],
  "scoped_python_basenames": {
    "__init__.py": "standard package marker",
    "__main__.py": "package-scoped command line entry point",
    "build.py": "registry-scoped build entry point",
    "query.py": "registry-scoped query entry point"
  }
}

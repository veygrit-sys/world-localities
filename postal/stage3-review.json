      "reason": "712547 appears in 18 rows; preserve and classify source_anomaly, excluded from standard lookup. Do not repair by guessing."
    },
    {
      "country_code": "MU",
      "decision": "separate_publication_formats",
      "reason": "4253 observations from three four-column CSVs selected for lookup; 1870 nonblank observations from three alternative three-column CSVs retained but inactive. Three-column metadata modification dates do not establish that underlying codes are older."
    },
    {
      "country_code": "MU",
      "decision": "explicit_blank_cell_exclusion",
      "reason": "The single empty postal-code cell at csv:record:545 in the mainland three-column file is declared and excluded from observations. Unmodified raw source retains that record."
    },
    {
      "country_code": "NA",
